rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User Profile schema validation
    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000));
    }

    // Executive Event schema validation
    function isValidEvent(data) {
      return data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.timeStart is string && data.timeStart.size() > 0 && data.timeStart.size() <= 50 &&
        data.timeEnd is string && data.timeEnd.size() > 0 && data.timeEnd.size() <= 50 &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('priority' in data) || (data.priority is string && data.priority.size() <= 50)) &&
        (!('conflict' in data) || (data.conflict is bool)) &&
        (!('conflictReason' in data) || (data.conflictReason is string && data.conflictReason.size() <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    // Executive Task schema validation
    function isValidTask(data) {
      return data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('priority' in data) || (data.priority is string && data.priority.size() <= 50)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('completed' in data) || (data.completed is bool)) &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 100));
    }

    // Executive Doc schema validation
    function isValidDoc(data) {
      return data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        data.docType is string && data.docType.size() > 0 && data.docType.size() <= 100 &&
        data.content is string && data.content.size() <= 500000;
    }

    // Users collection rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Events collection rules
    match /events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isSignedIn() && isValidId(eventId) && existing().userId == request.auth.uid &&
                    isValidEvent(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(eventId) && existing().userId == request.auth.uid;
    }

    // Tasks collection rules
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid &&
                    isValidTask(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
    }

    // Docs collection rules
    match /docs/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(docId) && isValidDoc(incoming());
      allow update: if isSignedIn() && isValidId(docId) && existing().userId == request.auth.uid &&
                    isValidDoc(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(docId) && existing().userId == request.auth.uid;
    }

    // Connection health check
    match /test/{docId} {
      allow read: if true;
    }
  }
}
